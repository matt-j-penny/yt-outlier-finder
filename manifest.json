{
  "manifest_version": 3,
  "name": "YT Outlier Finder",
  "version": "0.3.0",
  "description": "Filter YouTube videos live by outlier score, subscribers, and views. Save videos, titles and thumbnails to Content OS inspiration.",
  "action": {
    "default_title": "YT Outlier Finder",
    "default_popup": "popup.html"
  },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_start"
    }
  ],
  "permissions": [
    "storage",
    "contextMenus"
  ],
  "host_permissions": [
    "https://www.youtube.com/*",
    "https://youtube.com/*",
    "https://*/*",
    "http://localhost/*"
  ],
  "background": {
    "service_worker": "background.js"
  }
}
